# Copy this file to apps/web/.env.local after running the API seed command.
# The seed output provides the tenant and user IDs for your local database.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_TENANT_ID=replace-with-seeded-tenant-id
NEXT_PUBLIC_USER_ID=replace-with-seeded-school-admin-user-id
# This controls client-side navigation only; API permissions are checked server-side.
NEXT_PUBLIC_USER_ROLE=school-admin
