POSTGRES_DB=schoolpilot_dev
POSTGRES_USER=schoolpilot
POSTGRES_PASSWORD=schoolpilot_password
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=schoolpilot
S3_SECRET_KEY=schoolpilot-secret
S3_BUCKET=schoolpilot-local
S3_REGION=us-east-1
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
DATABASE_URL=postgresql://schoolpilot:schoolpilot_password@localhost:5432/schoolpilot_dev?schema=public
NODE_ENV=development
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_SANDBOX_BASE_URL=http://localhost:4000/mock-gateway
PAYMENT_GATEWAY_CURRENCY=NGN
# Generate a distinct local value; do not commit a real provider secret.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Optional HTTPS endpoint to receive failed-webhook alerts.
PAYMENT_WEBHOOK_ALERT_URL=
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_EMAIL_FROM=no-reply@schoolpilot.local
# Optional HTTPS endpoint for sandbox email delivery.
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_SMS_PROVIDER=mock
NOTIFICATION_SMS_SENDER=SchoolPilot
# Optional HTTPS endpoint for sandbox SMS delivery.
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_QUEUE_ATTEMPTS=3
NOTIFICATION_QUEUE_BACKOFF_MS=1000
REDIS_URL=redis://localhost:6379
REPORT_EXPORT_ASYNC_THRESHOLD=1000
REPORT_EXPORT_QUEUE_CONCURRENCY=2
REPORT_EXPORT_QUEUE_ATTEMPTS=3
REPORT_EXPORT_QUEUE_BACKOFF_MS=1000
REPORT_EXPORT_STORAGE_DIR=storage/report-exports
# Private upload adapter configuration. Generate a long unique signing secret locally.
UPLOAD_STORAGE_DIR=storage/uploads
UPLOAD_SIGNING_SECRET=
UPLOAD_SIGNED_URL_TTL_SECONDS=300
# Optional public API base for signed URL generation, e.g. https://api.example.com/uploads/signed
UPLOAD_SIGNED_URL_BASE=
